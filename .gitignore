# ESP-IDF builds
**/build/
**/sdkconfig
**/sdkconfig.old
**/managed_components/
**/dependencies.lock
**/.idf_component.yml.lock

# Local credentials/configuration
*.local
.env
.env.*
!.env.example

# CAD and slicer generated artefacts
*.stl
*.3mf
*.gcode
*.step
*.STP

# Editors
.vscode/
.idea/
.DS_Store
__pycache__/

# Optional browser-test dependencies
**/node_modules/
**/test-results/

# Local Home Assistant bridge environment
**/.venv/

# Native 4B local build/configuration (can contain credentials)
**/build-4b/
**/sdkconfig.4b
**/sdkconfig.4b.old
# Pin the tested native display dependency graph.
!touchscreen/dependencies.lock

# Direct Home Assistant credentials (compiled locally into the ESP firmware)
/touchscreen/*secrets.h*
!/touchscreen/secrets.h.example

/controller/*secrets.h*
!/controller/secrets.h.example

**/build-verify*/

# HW-747 local build configuration (may contain credentials)
**/build-supermini/
**/sdkconfig.supermini
**/sdkconfig.supermini.old
