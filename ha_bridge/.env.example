# Configure locally; never commit a real token. HA_TOKEN is a Home Assistant long-lived access token.
HA_TOKEN=
# Generate: python -c "import secrets; print(secrets.token_hex(16))"
COTTAGE_BRIDGE_TOKEN=
COTTAGE_BIND=127.0.0.1
COTTAGE_PORT=8087
# Optional private root CA PEM, only when HA uses a private certificate authority.
# COTTAGE_CA_FILE=/etc/cottage-thermo/ha-ca.pem
