# HW-747 Super Mini with ESP32-S3FH4R2: 4 MB flash / 2 MB QSPI PSRAM.
# The controller does not need PSRAM; leave it disabled.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CONFIG_SPIRAM is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_THERMO_SUPERMINI=y
CONFIG_THERMO_SERVO_GPIO=5
CONFIG_THERMO_ENCODER_SDA=6
CONFIG_THERMO_ENCODER_SCL=7
# CONFIG_THERMO_LIVE_BENCH is not set
