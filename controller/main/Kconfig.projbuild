menu "Cottage thermostat"
    config THERMO_SERVO_GPIO
        int "Servo signal GPIO (AtomS3 Lite rear G38)"
        range 0 48
        default 38
    config THERMO_AP_SSID
        string "Open bench access point SSID"
        default "CottageThermoBench"
    config THERMO_WIFI_SSID
        string "Optional LAN Wi-Fi SSID (blank = AP only)"
        default ""
    config THERMO_WIFI_PASSWORD
        string "LAN Wi-Fi password"
        default ""
    config THERMO_LIVE_BENCH
        bool "Enable physical output from thermostat engine (inert bench only)"
        default n
        help
            Default is simulation. Enabling still requires a fresh session arm,
            measured map and explicit observed-position synchronization.
            No encoder feedback exists; never restore motion on boot.
endmenu
