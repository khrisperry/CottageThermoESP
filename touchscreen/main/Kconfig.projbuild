menu "Cottage room thermostat"
    config ROOM_WIFI_SSID
        string "Controller bench AP or LAN SSID"
        default "CottageThermoBench"
    config ROOM_WIFI_PASSWORD
        string "Wi-Fi password (blank for bench AP)"
        default ""
    config ROOM_CONTROLLER_URL
        string "Controller base URL (no trailing slash)"
        default "http://192.168.4.1"
    config ROOM_API_TOKEN
        string "Controller pairing token from USB monitor"
        default ""
    config ROOM_SENSOR
        int "Probe: 0=disabled, 1=SHT31 (0x44), 2=SHT4x (0x44)"
        range 0 2
        default 0
    config ROOM_SDA
        int "External probe SDA (-1 until wiring is confirmed)"
        range -1 48
        default -1
    config ROOM_SCL
        int "External probe SCL (-1 until wiring is confirmed)"
        range -1 48
        default -1
    config ROOM_HA_BRIDGE_URL
        string "Optional local HA bridge URL (no trailing slash)"
        default ""
        help
            Example http://192.168.x.x:8087; run ha_bridge on a LAN host.
            The Home Assistant token stays on the host, not in firmware.
    config ROOM_HA_BRIDGE_TOKEN
        string "HA bridge client token (NOT the Home Assistant token)"
        default ""
endmenu
